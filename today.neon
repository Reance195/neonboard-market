{
  "manifest": {
    "id": "com.lin.today",
    "name": "今日概览",
    "version": "1.0.0",
    "apiVersion": 1,
    "description": "待办、进行中、今日完成与逾期统计",
    "main": "main.qml",
    "permissions": [
      "tasks.read"
    ]
  },
  "files": {
    "main.qml": "import QtQuick\n\nRectangle {\n    id: root\n    color: \"transparent\"\n\n    property int todoCount: 0\n    property int doingCount: 0\n    property int doneTodayCount: 0\n    property int overdueCount: 0\n\n    function refresh() {\n        if (!pluginHost.active)\n            return\n\n        var list = pluginHost.tasks()\n        var now = Date.now()\n        var start = new Date()\n        start.setHours(0, 0, 0, 0)\n\n        var todo = 0\n        var doing = 0\n        var doneToday = 0\n        var overdue = 0\n\n        for (var i = 0; i < list.length; ++i) {\n            var task = list[i]\n            if (task.status === \"todo\")\n                ++todo\n            else if (task.status === \"doing\")\n                ++doing\n            else if (task.status === \"done\"\n                     && Number(task.completedAt) >= start.getTime())\n                ++doneToday\n\n            if (task.status !== \"done\"\n                    && Number(task.dueAt) > 0\n                    && Number(task.dueAt) < now)\n                ++overdue\n        }\n\n        todoCount = todo\n        doingCount = doing\n        doneTodayCount = doneToday\n        overdueCount = overdue\n    }\n\n    Component.onCompleted: refresh()\n\n    component StatCard: Rectangle {\n        property string label: \"\"\n        property int value: 0\n        property color accent: \"#22D3EE\"\n\n        width: 160\n        height: 72\n        radius: 10\n        color: \"#0A1524\"\n        border.width: 1\n        border.color: Qt.rgba(accent.r, accent.g, accent.b, 0.35)\n\n        Column {\n            anchors.centerIn: parent\n            spacing: 3\n\n            Text {\n                anchors.horizontalCenter: parent.horizontalCenter\n                text: value\n                color: accent\n                font.pixelSize: 26\n                font.bold: true\n            }\n\n            Text {\n                anchors.horizontalCenter: parent.horizontalCenter\n                text: label\n                color: \"#7C8BA1\"\n                font.pixelSize: 10\n            }\n        }\n    }\n\n    Column {\n        anchors.centerIn: parent\n        width: Math.min(parent.width - 32, 340)\n        spacing: 14\n\n        Column {\n            width: parent.width\n            spacing: 3\n\n            Text {\n                anchors.horizontalCenter: parent.horizontalCenter\n                text: \"今日概览\"\n                color: \"#E6F1FF\"\n                font.pixelSize: 18\n                font.bold: true\n            }\n\n            Text {\n                anchors.horizontalCenter: parent.horizontalCenter\n                text: \"TODAY / OVERVIEW\"\n                color: \"#22D3EE\"\n                font.pixelSize: 9\n                font.letterSpacing: 2\n            }\n        }\n\n        Grid {\n            width: parent.width\n            columns: 2\n            columnSpacing: 8\n            rowSpacing: 8\n\n            StatCard {\n                width: (parent.width - parent.columnSpacing) / 2\n                label: \"待办\"\n                value: root.todoCount\n                accent: \"#22D3EE\"\n            }\n\n            StatCard {\n                width: (parent.width - parent.columnSpacing) / 2\n                label: \"进行中\"\n                value: root.doingCount\n                accent: \"#A78BFA\"\n            }\n\n            StatCard {\n                width: (parent.width - parent.columnSpacing) / 2\n                label: \"今日完成\"\n                value: root.doneTodayCount\n                accent: \"#F472B6\"\n            }\n\n            StatCard {\n                width: (parent.width - parent.columnSpacing) / 2\n                label: \"逾期\"\n                value: root.overdueCount\n                accent: root.overdueCount > 0 ? \"#F472B6\" : \"#4B6478\"\n            }\n        }\n\n        Rectangle {\n            width: parent.width\n            height: 34\n            radius: 8\n            color: refreshArea.pressed ? \"#12303A\" : \"#0B1B26\"\n            border.width: 1\n            border.color: refreshArea.containsMouse ? \"#22D3EE\" : \"#1E4A57\"\n\n            Text {\n                anchors.centerIn: parent\n                text: \"刷新概览\"\n                color: \"#E6F1FF\"\n                font.pixelSize: 12\n            }\n\n            MouseArea {\n                id: refreshArea\n                anchors.fill: parent\n                hoverEnabled: true\n                cursorShape: Qt.PointingHandCursor\n                onClicked: root.refresh()\n            }\n        }\n\n        Text {\n            width: parent.width\n            horizontalAlignment: Text.AlignHCenter\n            text: \"数据来自本地 SQLite\"\n            color: \"#5B6B80\"\n            font.pixelSize: 9\n        }\n    }\n}\n"
  }
}