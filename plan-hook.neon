{
  "manifest": {
    "id": "com.lin.plan-hook",
    "name": "计划钩子",
    "version": "1.0.0",
    "apiVersion": 2,
    "description": "提交信息里的 #短号 标记（如 #T12）自动把对应任务流转到进行中 / 已办结",
    "category": "任务自动化",
    "dependencies": [
      "依赖宿主 Git 钩子链路（post-commit 投递 → hooks.db 事件队列，仓库自带）",
      "宿主需支持 apiVersion 2"
    ],
    "main": "main.qml",
    "background": "background.qml",
    "permissions": [
      "tasks.read",
      "tasks.write",
      "meta",
      "events"
    ],
    "contributes": {
      "events": [
        "hook.commit"
      ],
      "commands": []
    }
  },
  "files": {
    "background.qml": "import QtQuick\nimport \"rules.js\" as Rules\n\n// 后台常驻入口：由宿主在子 QQmlContext 里加载，\n// 注入的 pluginHost 就是本插件专属门面（权限天然隔离，不会拿到别的插件的权限）。\n// 职责：订阅 hook.commit 事件 → 按规则把任务流转到目标状态。\nQtObject {\n    id: root\n\n    // 最近一次事件摘要，供宿主日志 / 面板查看\n    property string lastEvent: \"\"\n    property int lastActionCount: 0\n    property int handledCount: 0\n\n    function readRules() {\n        return Rules.parseRules(pluginHost.metaValue(\"plan.rules\", \"\"));\n    }\n\n    // 把提交信息里的标记落到任务上，返回实际流转的任务数\n    function applyText(text) {\n        var rules = readRules();\n        if (!rules.enabled)\n            return 0;\n\n        var actions = Rules.planActions(text, pluginHost.tasks(), rules);\n        for (var i = 0; i < actions.length; i++)\n            pluginHost.moveTaskToEnd(actions[i].id, actions[i].status);\n\n        if (actions.length > 0) {\n            pluginHost.log(\"plan-hook: \" + actions.length + \" task(s) moved, first=\"\n                           + actions[0].title + \" -> \" + actions[0].status);\n        }\n        return actions.length;\n    }\n\n    function onHookCommit(payload) {\n        var text = (payload && payload.text) ? String(payload.text) : \"\";\n        if (text.length === 0)\n            return;\n        lastEvent = text;\n        lastActionCount = applyText(text);\n        handledCount += 1;\n    }\n\n    Component.onCompleted: {\n        pluginHost.subscribe([\"hook.commit\"]);\n        pluginHost.eventReceived.connect(function (name, payload) {\n            if (name === \"hook.commit\")\n                onHookCommit(payload);\n        });\n        pluginHost.log(\"plan-hook: background ready\");\n    }\n}\n",
    "main.qml": "import QtQuick\nimport QtQuick.Controls\nimport QtQuick.Layouts\nimport NeonBoard\nimport \"rules.js\" as Rules\n\n// 计划钩子面板：规则编辑器 + 手动执行 + 执行记录。\n// 规则存在 meta 表的 plan.rules 键里（与后台入口 background.qml 共用同一份），\n// 因此这里的改动会立刻影响提交触发的自动流转行为。\nRectangle {\n    id: root\n\n    color: \"transparent\"\n\n    property var rules: Rules.defaultRules()\n    property var records: []\n\n    function readRules() {\n        rules = Rules.parseRules(pluginHost.metaValue(\"plan.rules\", \"\"))\n        var ds = rules.defaultStatus\n        defaultStatusBox.currentIndex = ds === \"done\" ? 1 : (ds === \"todo\" ? 2 : 0)\n        var mf = (rules.match && rules.match.field) ? rules.match.field : \"title\"\n        matchFieldBox.currentIndex = mf === \"note\" ? 1 : (mf === \"tags\" ? 2 : 0)\n        alreadyBox.currentIndex = rules.onAlreadyInTarget === \"move\" ? 1 : 0\n    }\n\n    function saveRules() {\n        if (pluginHost.setMetaValue(\"plan.rules\", JSON.stringify(rules)))\n            statusText.text = \"规则已保存\"\n        else\n            statusText.text = \"保存失败：缺少 meta 权限\"\n    }\n\n    function runManual() {\n        var text = inputField.text ? inputField.text : \"\"\n        if (text.trim().length === 0) {\n            statusText.text = \"请输入提交信息\"\n            return\n        }\n        var actions = Rules.planActions(text, pluginHost.tasks(), rules)\n        for (var i = 0; i < actions.length; i++)\n            pluginHost.moveTaskToEnd(actions[i].id, actions[i].status)\n\n        records.unshift({\n            \"text\": text,\n            \"count\": actions.length,\n            \"time\": new Date().toLocaleTimeString()\n        })\n        while (records.length > 20)\n            records.pop()\n\n        statusText.text = actions.length > 0 ? (actions.length + \" 个任务已流转\") : \"未匹配到任务\"\n    }\n\n    Component.onCompleted: readRules()\n\n    ColumnLayout {\n        anchors.fill: parent\n        spacing: 8\n\n        ScrollView {\n            Layout.fillWidth: true\n            Layout.fillHeight: true\n            clip: true\n            contentWidth: availableWidth\n\n            ColumnLayout {\n                width: parent.width\n                spacing: 10\n\n                // ---------- 规则区 ----------\n                Text {\n                    text: \"规则\"\n                    color: Theme.text\n                    font.pixelSize: 12\n                    font.bold: true\n                }\n\n                RowLayout {\n                    Layout.fillWidth: true\n\n                    Text {\n                        text: \"启用\"\n                        color: Theme.text\n                        font.pixelSize: 11\n                    }\n\n                    Item { Layout.fillWidth: true }\n\n                    Switch {\n                        checked: root.rules.enabled !== false\n                        onToggled: {\n                            root.rules.enabled = checked\n                            root.saveRules()\n                        }\n                    }\n                }\n\n                RowLayout {\n                    Layout.fillWidth: true\n                    spacing: 8\n\n                    Text {\n                        text: \"默认目标\"\n                        color: Theme.muted\n                        font.pixelSize: 10\n                        Layout.preferredWidth: 60\n                    }\n\n                    ComboBox {\n                        id: defaultStatusBox\n                        Layout.fillWidth: true\n                        model: [\"doing\", \"done\", \"todo\"]\n                        font.pixelSize: 10\n                        onActivated: {\n                            root.rules.defaultStatus = currentText\n                            root.saveRules()\n                        }\n                    }\n                }\n\n                RowLayout {\n                    Layout.fillWidth: true\n                    spacing: 8\n\n                    Text {\n                        text: \"匹配字段\"\n                        color: Theme.muted\n                        font.pixelSize: 10\n                        Layout.preferredWidth: 60\n                    }\n\n                    ComboBox {\n                        id: matchFieldBox\n                        Layout.fillWidth: true\n                        model: [\"title\", \"note\", \"tags\"]\n                        font.pixelSize: 10\n                        onActivated: {\n                            root.rules.match.field = currentText\n                            root.saveRules()\n                        }\n                    }\n                }\n\n                RowLayout {\n                    Layout.fillWidth: true\n                    spacing: 8\n\n                    Text {\n                        text: \"已在目标列\"\n                        color: Theme.muted\n                        font.pixelSize: 10\n                        Layout.preferredWidth: 60\n                    }\n\n                    ComboBox {\n                        id: alreadyBox\n                        Layout.fillWidth: true\n                        model: [\"skip\", \"move\"]\n                        font.pixelSize: 10\n                        onActivated: {\n                            root.rules.onAlreadyInTarget = currentText\n                            root.saveRules()\n                        }\n                    }\n                }\n\n                Text {\n                    Layout.fillWidth: true\n                    text: \"提交信息里写 #T12 → 标题含 #T12 的任务转为进行中；#T12=done / #T12=todo 指定目标状态。\"\n                    color: Theme.muted\n                    font.pixelSize: 9\n                    wrapMode: Text.WordWrap\n                }\n\n                Rectangle {\n                    Layout.fillWidth: true\n                    height: 1\n                    color: Theme.border\n                }\n\n                // ---------- 手动执行区 ----------\n                Text {\n                    text: \"手动执行\"\n                    color: Theme.text\n                    font.pixelSize: 12\n                    font.bold: true\n                }\n\n                TextField {\n                    id: inputField\n                    Layout.fillWidth: true\n                    placeholderText: \"粘贴提交信息，例如 fix(model): 修复 #T12 统计刷新\"\n                    font.pixelSize: 10\n                }\n\n                Rectangle {\n                    Layout.fillWidth: true\n                    height: 30\n                    radius: 8\n                    color: runArea.pressed ? Theme.elevated : Theme.card\n                    border.width: 1\n                    border.color: Theme.border\n\n                    Text {\n                        anchors.centerIn: parent\n                        text: \"执行\"\n                        color: Theme.cyan\n                        font.pixelSize: 11\n                    }\n\n                    MouseArea {\n                        id: runArea\n                        anchors.fill: parent\n                        hoverEnabled: true\n                        cursorShape: Qt.PointingHandCursor\n                        onClicked: root.runManual()\n                    }\n                }\n\n                Text {\n                    id: statusText\n                    Layout.fillWidth: true\n                    text: \"\"\n                    color: Theme.muted\n                    font.pixelSize: 9\n                    elide: Text.ElideRight\n                }\n\n                // ---------- 执行记录 ----------\n                Text {\n                    text: \"执行记录\"\n                    color: Theme.text\n                    font.pixelSize: 12\n                    font.bold: true\n                }\n\n                Repeater {\n                    model: root.records\n\n                    Text {\n                        required property var modelData\n                        Layout.fillWidth: true\n                        text: modelData.time + \" · \" + modelData.count + \" 个任务 · \"\n                              + modelData.text.split(\"\\n\")[0]\n                        color: Theme.muted\n                        font.pixelSize: 9\n                        elide: Text.ElideRight\n                    }\n                }\n            }\n        }\n    }\n}\n",
    "rules.js": "// 计划钩子规则引擎（纯函数，无 QML 依赖）。\n// background.qml（事件驱动）与 main.qml（手动执行）共用同一套解析与匹配逻辑，\n// 保证「提交触发」和「界面手动触发」的结果完全一致。\n//\n// 标记语法：\n//   #T12        → 默认目标状态（doing）\n//   #T12=done   → 已办结\n//   #T12=todo   → 待办\n// 短号大小写不敏感，比较时统一大写；整词匹配（#T1 不会命中 #T12）。\n// 任务侧的短号写在标题里（也可按规则改匹配备注 / 标签）。\n\nvar DEFAULT_RULES = {\n    \"version\": 1,\n    \"enabled\": true,\n    \"defaultStatus\": \"doing\",\n    \"match\": {\n        \"field\": \"title\",\n        \"pattern\": \"#([A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)?)(?:=(todo|doing|done))?\"\n    },\n    \"statusMap\": {\n        \"todo\": \"todo\",\n        \"doing\": \"doing\",\n        \"done\": \"done\"\n    },\n    \"insert\": \"end\",\n    \"onAlreadyInTarget\": \"skip\"\n};\n\nvar MARKER_PATTERN = /#([A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)?)(?:=(todo|doing|done))?/g;\nvar CODE_PATTERN = /#([A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)?)/g;\n\nfunction defaultRules() {\n    return JSON.parse(JSON.stringify(DEFAULT_RULES));\n}\n\n// 宽松解析：坏 JSON 或缺字段一律回落到默认值，不让插件因脏数据崩掉\nfunction parseRules(raw) {\n    var rules = defaultRules();\n    if (typeof raw !== \"string\" || raw.length === 0)\n        return rules;\n\n    var parsed = null;\n    try {\n        parsed = JSON.parse(raw);\n    } catch (e) {\n        return rules;\n    }\n    if (!parsed || typeof parsed !== \"object\")\n        return rules;\n\n    for (var key in parsed) {\n        if (Object.prototype.hasOwnProperty.call(parsed, key))\n            rules[key] = parsed[key];\n    }\n    if (!rules.match || typeof rules.match !== \"object\")\n        rules.match = defaultRules().match;\n    if (!rules.statusMap || typeof rules.statusMap !== \"object\")\n        rules.statusMap = defaultRules().statusMap;\n    return rules;\n}\n\n// 从提交信息里提取标记：[{ code: \"T12\", status: \"doing\" }]\nfunction extractMarkers(text, defaultStatus) {\n    var markers = [];\n    if (typeof text !== \"string\" || text.length === 0)\n        return markers;\n\n    var seen = {};\n    MARKER_PATTERN.lastIndex = 0;\n    var matched = MARKER_PATTERN.exec(text);\n    while (matched !== null) {\n        var code = matched[1].toUpperCase();\n        if (!seen[code]) {\n            seen[code] = true;\n            markers.push({\n                code: code,\n                status: matched[2] ? matched[2].toLowerCase() : (defaultStatus || \"doing\")\n            });\n        }\n        matched = MARKER_PATTERN.exec(text);\n    }\n    return markers;\n}\n\n// 取出任务在指定匹配字段上的文本\nfunction taskField(task, field) {\n    if (!task)\n        return \"\";\n    if (field === \"note\")\n        return task.note ? String(task.note) : \"\";\n    if (field === \"tags\")\n        return task.tags ? String(task.tags) : \"\";\n    return task.title ? String(task.title) : \"\";\n}\n\n// 文本里出现的所有短号（大写）\nfunction codesIn(text) {\n    var codes = {};\n    if (typeof text !== \"string\" || text.length === 0)\n        return codes;\n    CODE_PATTERN.lastIndex = 0;\n    var matched = CODE_PATTERN.exec(text);\n    while (matched !== null) {\n        codes[matched[1].toUpperCase()] = true;\n        matched = CODE_PATTERN.exec(text);\n    }\n    return codes;\n}\n\n// 计算待执行动作：[{ id, title, status }]\nfunction planActions(text, tasks, rules) {\n    var config = parseRules(rules);\n    var actions = [];\n    if (!config.enabled)\n        return actions;\n\n    var markers = extractMarkers(text, config.defaultStatus);\n    if (markers.length === 0)\n        return actions;\n\n    var markerByCode = {};\n    for (var i = 0; i < markers.length; i++)\n        markerByCode[markers[i].code] = markers[i];\n\n    var list = tasks || [];\n    for (var j = 0; j < list.length; j++) {\n        var task = list[j];\n        var codes = codesIn(taskField(task, config.match.field));\n        for (var code in codes) {\n            if (!Object.prototype.hasOwnProperty.call(codes, code))\n                continue;\n            var marker = markerByCode[code];\n            if (!marker)\n                continue;\n            var target = config.statusMap[marker.status] || marker.status;\n            if (config.onAlreadyInTarget === \"skip\" && task.status === target)\n                break;\n            actions.push({ id: task.id, title: task.title, status: target });\n            break;\n        }\n    }\n    return actions;\n}\n"
  }
}